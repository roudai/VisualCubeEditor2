rules_version = '2';
// Firebase プロジェクト共通のルール（Megaminx Image Editor・VisualCube Editor など、同じプロジェクトのアプリで使う）。
// このファイルは MegaminxImageEditor と VisualCubeEditor2 の両方のリポジトリに同じ内容で置いている（片方を変えたらもう片方も変える）。
// Firebase コンソール → Firestore Database → ルール にこの内容を貼り付けて公開する。
// 各アプリは users/{uid}/apps/{appId} の1文書に { json: 文字列, savedAt: 時刻 } を保存する
// （例：users/{uid}/apps/megaminx-image-editor）。本人の文書だけを読み書き・削除できる。
// 作る・書き換えるのは appIds() に書いたアプリ名と、その練習の記録の文書（下の logDoc）だけ
// （名前を変えて文書をいくらでも作られないように）。アプリを増やしたら appIds() と logDoc() の両方に名前を足して貼り直す。
// 読む・削除するのはどの名前でもよい（アカウントのデータ削除で全部消せるように）。
// 練習の記録は 1 文書（json 50 万文字未満）に入らないので、種類ごとの文書 <アプリ名>-log-<種類> に分けて保存する
// （例：megaminx-image-editor-log-pll・megaminx-image-editor-log-oll）。種類は英小文字・数字の 1〜12 文字で、
// 種類を増やしてもルールは変えなくてよい。
service cloud.firestore {
  match /databases/{database}/documents {
    function appIds() {
      return ['megaminx-image-editor', 'visualcube-editor'];
    }
    function logDoc(appId) {
      return appId.matches('(megaminx-image-editor|visualcube-editor)-log-[a-z0-9]{1,12}');
    }
    match /users/{userId}/apps/{appId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && (appId in appIds() || logDoc(appId))
        && request.resource.data.keys().hasOnly(['json', 'savedAt'])
        && request.resource.data.json is string
        && request.resource.data.json.size() < 500000;
    }
  }
}
